# Razorpay TEST mode credentials — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo controls
# 1 = accept the webhook and discard it, producing a real broken state on stage
DEMO_DROP_WEBHOOK=0
# live | replay   (replay serves recorded traces if the LLM rate-limits)
DEMO_MODE=live
# gemini | groq   (which provider agents/llm.py's get_llm() returns)
LLM_PROVIDER=gemini

# Gemini free tier — https://aistudio.google.com/apikey — powers agents/llm.py
GEMINI_API_KEY=
# Groq free tier — https://console.groq.com/keys — alternate provider, used when
# LLM_PROVIDER=groq. GROQ_MODEL defaults to openai/gpt-oss-120b — check
# console.groq.com/docs/models for what's currently live; Groq deprecates
# models on short notice and a stale name 404s, it doesn't fall back silently.
GROQ_API_KEY=
